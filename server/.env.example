PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Database configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulsepath?schema=public"

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_pulsepath_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_pulsepath_2026

# AI Triage configuration
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Cloudinary for avatars
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
